# ─── Server ───────────────────────────────────────────────────────────
PORT=3001
DB_PATH=./data/goalscore.db

# ─── Football Data API ────────────────────────────────────────────────
FOOTBALL_DATA_TOKEN=<your-football-data.org-api-key>

# ─── Solana ───────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
ORACLE_KEYPAIR_PATH=/path/to/deployer-keypair.json
# OR for deployed environments (e.g. Railway):
# ORACLE_KEYPAIR_JSON=<base64-encoded-keypair-json>
TREASURY_ADDRESS=<treasury-wallet-pubkey>
ARENA_PROGRAM_ID=EPpsfGUp4Na92W6cYFz88X3AuxqsC8q6rveHn29iETrL

# ─── $GOAL Token ──────────────────────────────────────────────────────
GOAL_TOKEN_MINT=<goal-spl-token-mint-address>

# ─── Oracle Gating ────────────────────────────────────────────────────
# Minimum raw $GOAL balance to see oracle predictions (changeable anytime)
ORACLE_GATE_MINIMUM=100000

# ─── Privy ────────────────────────────────────────────────────────────
PRIVY_APP_ID=<your-privy-app-id>
PRIVY_APP_SECRET=<your-privy-app-secret>

# ─── OpenAI (optional — for Oracle AI analysis) ──────────────────────
# OPENAI_API_KEY=<your-openai-key>

# ─── Admin API Key (for protected routes) ─────────────────────────────
ADMIN_API_KEY=<generate-a-secure-random-hex-string>
