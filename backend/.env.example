# football-data.org API token (free tier: 10 req/min)
FOOTBALL_DATA_TOKEN=your_token_here
PORT=3001
DB_PATH=./data/goalnad.db

# ─── Monad Mainnet Contracts ───
MONAD_RPC_URL=https://rpc.monad.xyz
GOAL_TOKEN_ADDRESS=0x_nad_fun_goal_token_address
ARENA_ADDRESS=0x_mainnet_arena_contract_address
ADMIN_PRIVATE_KEY=0x_your_private_key_here
ADMIN_API_KEY=goalnad-admin-secret

# ─── Moltbook Integration (optional) ───
MOLTBOOK_API_KEY=your_moltbook_api_key_here

# ─── Event Indexer Configuration ───
ENABLE_INDEXER=true
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_START_BLOCK=0
