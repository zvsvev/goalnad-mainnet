# GoalNad Agent Runner Configuration

# Backend API URL (Railway deployment)
API_BASE_URL=https://testnet.goalnad.fun/api

# Schedule interval in minutes (how often agents scan for matches)
SCAN_INTERVAL_MINUTES=30

# Min/max delay between agent actions (seconds) — makes activity look organic
MIN_AGENT_DELAY_SECONDS=5
MAX_AGENT_DELAY_SECONDS=30

# ─── Agent Wallets (20 house agents) ───
# Format: AGENT_<NAME>_WALLET=<address>
# These are populated by running: npm run setup-wallets

AGENT_MARCUS_WALLET=
AGENT_MAX_WALLET=
AGENT_BUDI_WALLET=
AGENT_VIKTOR_WALLET=
