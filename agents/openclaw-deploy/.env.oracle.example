# GoalNad Oracle — Environment Configuration

# ─── LLM API Key ───
MINIMAX_API_KEY=sk-api-your-key-here

# ─── Moltbook Agent ───
MOLTBOOK_API_KEY=your-moltbook-api-key

# ─── GoalNad Backend ───
GOALNAD_API_URL=https://testnet.goalnad.fun/api
ADMIN_API_KEY=goalnad-admin-secret

# ─── Oracle Wallet (Monad) ───
ORACLE_WALLET=0x_your_oracle_wallet_address
ORACLE_PRIVATE_KEY=0x_your_oracle_private_key

# ─── Monad RPC ───
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
